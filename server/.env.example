# ELWO Music Platform - Environment Configuration Example
# Copy this file to .env and change the secrets for production

PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/elwo_music

# JWT Secrets (Generate random 64-character strings for production)
JWT_SECRET=replace_with_strong_random_jwt_secret_key_for_mobile_users
ADMIN_JWT_SECRET=replace_with_strong_random_admin_jwt_secret_key

# Default Super Admin Seed Credentials
DEFAULT_ADMIN_EMAIL=admin@elwo.stream
DEFAULT_ADMIN_PASSWORD=ChangeMeInProduction!2026
